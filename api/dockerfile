# Base vide : aucune image Docker Hub.
FROM scratch
# Extraction du systeme Alpine officiel prepare par prepare.py.
ADD .docker/alpine.tar.gz /
# Python execute l'API ; le compte app evite un lancement en root.
RUN apk add --no-cache python3 \
    && addgroup -S -g 10001 app \
    && adduser -S -D -H -u 10001 -G app app

# Repertoire du code applicatif.
WORKDIR /app
# Copie de l'API et du client Minecraft avec le bon proprietaire.
COPY --chown=10001:10001 api/main.py api/minecraft.py ./
# Logs immediats, pas de fichiers pyc, port interne par defaut.
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PORT=5000
# Execution sous le compte non privilegie UID/GID 10001.
USER 10001:10001

# Port documente ; aucune publication sur l'hote ici.
EXPOSE 5000
# Signal traite par main.py pour fermer le serveur HTTP.
STOPSIGNAL SIGTERM
# Forme exec : Python recoit directement les signaux Docker.
ENTRYPOINT ["python3", "/app/main.py"]
